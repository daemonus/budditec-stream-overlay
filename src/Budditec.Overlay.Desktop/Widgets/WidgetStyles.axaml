<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <Style Selector="Border.pill.live">
    <Setter Property="Background" Value="#E0E91916" />
  </Style>
  <Style Selector="Ellipse.recDot">
    <Setter Property="Fill" Value="#666666" />
  </Style>
  <Style Selector="Ellipse.recDot.recording">
    <Setter Property="Fill" Value="#FF2B2B" />
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.recDot.paused">
    <Setter Property="Fill" Value="#FFC83D" />
  </Style>
</Styles>
