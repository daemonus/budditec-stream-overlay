<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Budditec.Overlay.Desktop.Widgets"
             x:Class="Budditec.Overlay.Desktop.Widgets.StatusView"
             x:DataType="vm:StatusViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="#99000000" />
    </Style>
    <Style Selector="Border.pill.live">
      <Setter Property="Background" Value="#E0E91916" />
    </Style>
    <Style Selector="Ellipse.recDot">
      <Setter Property="Fill" Value="#666666" />
    </Style>
    <Style Selector="Ellipse.recDot.recording">
      <Setter Property="Fill" Value="#FF2B2B" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.recDot.paused">
      <Setter Property="Fill" Value="#FFC83D" />
    </Style>
    <Style Selector="Path.mic">
      <Setter Property="Fill" Value="#B3FFFFFF" />
    </Style>
    <Style Selector="Path.mic.active">
      <Setter Property="Fill" Value="#53FC18" />
    </Style>
    <Style Selector="Path.mic.muted">
      <Setter Property="Fill" Value="#FF4D4D" />
    </Style>
    <Style Selector="Border.meter">
      <Setter Property="Background" Value="#B3FFFFFF" />
    </Style>
    <Style Selector="Border.meter.active">
      <Setter Property="Background" Value="#53FC18" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="6" Spacing="6">
    <StackPanel.Effect>
      <DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="3" Color="Black" />
    </StackPanel.Effect>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Border Classes="pill">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Classes="recDot" Classes.recording="{Binding IsRecording}" Classes.paused="{Binding IsPaused}"
                   Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RecordLabel}" />
        </StackPanel>
      </Border>
      <Border Classes="pill" Classes.live="{Binding Streaming}">
        <TextBlock Text="LIVE" />
      </Border>
      <TextBlock Text="{Binding ObsDetail}" FontSize="11" FontWeight="Normal" Opacity="0.8" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioSourceViewModel">
          <Grid ColumnDefinitions="22,*" RowDefinitions="Auto,4">
            <Panel Grid.RowSpan="2" Width="18" Height="18" VerticalAlignment="Center">
              <Path Classes="mic" Classes.active="{Binding IsActive}" Classes.muted="{Binding Muted}" Stretch="Uniform"
                    Data="M12,14 A3,3 0 0 0 15,11 V5 A3,3 0 0 0 9,5 V11 A3,3 0 0 0 12,14 Z M17,11 A5,5 0 0 1 7,11 H5 A7,7 0 0 0 11,17.9 V21 H13 V17.9 A7,7 0 0 0 19,11 Z" />
              <Line IsVisible="{Binding Muted}" StartPoint="1,1" EndPoint="17,17" Stroke="#FF4D4D" StrokeThickness="2.5" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" />
            <Border Grid.Column="1" Grid.Row="1" Background="#40FFFFFF" CornerRadius="2" Width="120" HorizontalAlignment="Left">
              <Border Classes="meter" Classes.active="{Binding IsActive}" CornerRadius="2" HorizontalAlignment="Left"
                      Width="{Binding Level, Converter={x:Static vm:StatusView.LevelToWidth}}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
